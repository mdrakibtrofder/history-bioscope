# History Bioscope API configuration
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Document storage driver: json | mongo | postgres
STORAGE_DRIVER=json
# JSON driver: database file + seed folder (relative to backend/)
JSON_DB_PATH=storage/db.json
SEED_DIR=../data/seed

# Media storage driver: local | minio | cloudinary | s3
MEDIA_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:4000

# Future drivers (not needed for local use)
MONGO_URI=mongodb://localhost:27017/history_bioscope
POSTGRES_URL=postgres://user:pass@localhost:5432/history_bioscope
MINIO_ENDPOINT=
MINIO_BUCKET=
CLOUDINARY_URL=
S3_BUCKET=
S3_REGION=
